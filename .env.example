# Public URL of the deployed app (no trailing slash)
APP_URL=https://your-app.vercel.app

# Supabase: project URL + publishable (anon) key. Access is locked by RLS to
# requests carrying FS_DB_SECRET (stored in fs_private.config, see migration).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_...
FS_DB_SECRET=

# Prices: free token from https://www.travelpayouts.com (Developers > API token)
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts marker, added to booking links (affiliate earnings)
TRAVELPAYOUTS_MARKER=

# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FareSniperBot
# Any random string; also passed to setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=

# Email (optional): https://resend.com, needs a verified domain to email anyone
RESEND_API_KEY=
EMAIL_FROM="Fare Sniper <alerts@yourdomain.com>"

# Protects /api/cron/check (Vercel cron sends it automatically)
CRON_SECRET=

# Auto-hold demo: Duffel TEST token (starts with duffel_test_)
DUFFEL_TEST_TOKEN=
